<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>NestG launcher</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <UseWindowsForms>True</UseWindowsForms>
    <ApplicationConfigurationInitialize>false</ApplicationConfigurationInitialize>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="NestG.SteamDpi.Helper.exe" />
    <None Remove="NestG.SteamDpi.Helper.json" />
    <None Remove="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.0.json" />
    <None Remove="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.1.json" />
    <None Remove="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.2.json" />
    <None Remove="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.3.json" />
    <None Remove="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.4.json" />
    <None Remove="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.5.json" />
    <None Remove="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.6.json" />
    <None Remove="NestG.RuntimeBundles.bettersteamtools-cloud.json" />
    <None Remove="NestG.RuntimeBundles.opensteamtool-cloud.json" />
    <None Remove="NestG.SteamConnection.Icons.arrow-clockwise.svg" />
    <None Remove="NestG.SteamConnection.Icons.box-arrow-up-right.svg" />
    <None Remove="NestG.SteamConnection.Icons.check-lg.svg" />
    <None Remove="NestG.SteamConnection.Icons.chevron-down.svg" />
    <None Remove="NestG.SteamConnection.Icons.dash-lg.svg" />
    <None Remove="NestG.SteamConnection.Icons.exclamation-lg.svg" />
    <None Remove="NestG.SteamConnection.Icons.steam.svg" />
    <None Remove="NestG.SteamConnection.Icons.x-lg.svg" />
    <None Remove="NestG.SupportContact.Icons.copy.svg" />
    <None Remove="NestG.SupportContact.Icons.headset.svg" />
    <None Remove="NestG.SupportContact.Icons.telephone.svg" />
    <None Remove="app_desktop.Services.SteamExclusions.DefenderCommon.ps1" />
    <None Remove="app_desktop.Services.SteamExclusions.DefenderApply.ps1" />
    <None Remove="app_desktop.Services.SteamExclusions.DefenderOwnership.ps1" />
    <None Remove="app_desktop.Services.SteamExclusions.DefenderManagedApply.ps1" />
    <EmbeddedResource Include="NestG.SteamDpi.Helper.exe" LogicalName="NestG.SteamDpi.Helper.exe" />
    <EmbeddedResource Include="NestG.SteamDpi.Helper.json" LogicalName="NestG.SteamDpi.Helper.json" />
    <EmbeddedResource Include="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.0.json" LogicalName="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.0.json" />
    <EmbeddedResource Include="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.1.json" LogicalName="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.1.json" />
    <EmbeddedResource Include="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.2.json" LogicalName="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.2.json" />
    <EmbeddedResource Include="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.3.json" LogicalName="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.3.json" />
    <EmbeddedResource Include="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.4.json" LogicalName="NestG.RuntimeBundles.bettersteamtools-cloud-1.0.4.json" />
