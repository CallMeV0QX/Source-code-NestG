    <EmbeddedResource Include="NestG.RuntimeBundles.opensteamtool-cloud.json" LogicalName="NestG.RuntimeBundles.opensteamtool-cloud.json" />
    <EmbeddedResource Include="NestG.SteamConnection.Icons.arrow-clockwise.svg" LogicalName="NestG.SteamConnection.Icons.arrow-clockwise.svg" />
    <EmbeddedResource Include="NestG.SteamConnection.Icons.box-arrow-up-right.svg" LogicalName="NestG.SteamConnection.Icons.box-arrow-up-right.svg" />
    <EmbeddedResource Include="NestG.SteamConnection.Icons.check-lg.svg" LogicalName="NestG.SteamConnection.Icons.check-lg.svg" />
