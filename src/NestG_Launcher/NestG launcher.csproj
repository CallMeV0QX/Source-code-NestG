    <EmbeddedResource Include="NestG.SteamConnection.Icons.steam.svg" LogicalName="NestG.SteamConnection.Icons.steam.svg" />
    <EmbeddedResource Include="NestG.SteamConnection.Icons.x-lg.svg" LogicalName="NestG.SteamConnection.Icons.x-lg.svg">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="NestG.SupportContact.Icons.copy.svg" LogicalName="NestG.SupportContact.Icons.copy.svg" />
    <EmbeddedResource Include="NestG.SupportContact.Icons.headset.svg" LogicalName="NestG.SupportContact.Icons.headset.svg" />
    <EmbeddedResource Include="NestG.SupportContact.Icons.telephone.svg" LogicalName="NestG.SupportContact.Icons.telephone.svg" />
    <EmbeddedResource Include="app_desktop.Services.SteamExclusions.DefenderCommon.ps1" LogicalName="app_desktop.Services.SteamExclusions.DefenderCommon.ps1" />
    <EmbeddedResource Include="app_desktop.Services.SteamExclusions.DefenderApply.ps1" LogicalName="app_desktop.Services.SteamExclusions.DefenderApply.ps1" />
    <EmbeddedResource Include="app_desktop.Services.SteamExclusions.DefenderOwnership.ps1" LogicalName="app_desktop.Services.SteamExclusions.DefenderOwnership.ps1" />
    <EmbeddedResource Include="app_desktop.Services.SteamExclusions.DefenderManagedApply.ps1" LogicalName="app_desktop.Services.SteamExclusions.DefenderManagedApply.ps1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3405.78" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="Tomlyn" Version="0.19.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.enc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
